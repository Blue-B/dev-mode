{
  "source": {
    "include": ["application/client/loan-client/src", "chaincode"],
    "includePattern": ".+\\.js(x)?$",
    "excludePattern": "(node_modules/|docs)"
  },
  "plugins": ["plugins/markdown"],
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  },
  "opts": {
    "destination": "./docs/frontend",
    "recurse": true,
    "readme": "./README.md"
  }
} 